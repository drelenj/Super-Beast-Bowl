{
  "name": "super-beast-bowl-arcade",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "build:roster": "python3 -I scripts/build_roster.py",
    "build:tech": "tsx scripts/build_tech.ts",
    "headless": "tsx scripts/headless.ts",
    "stats": "tsx scripts/stats20.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts",
    "smoke": "node tests/smoke.cjs",
    "bench": "tsx scripts/bench.ts"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}